-- Lưu vị trí gốc của tay
local originalLeftArmCFrame = nil
local originalRightArmCFrame = nil

-- Hàm lấy character mới
local function getCharacter()
	character = player.Character or player.CharacterAdded:Wait()
	return character
end

player.CharacterAdded:Connect(function(char)
	character = char
end)

-- Hàm kéo tay ra sau
local function extendArms()
	local char = getCharacter()
	if not char then return end
	
	local humanoidRootPart = char:FindFirstChild("HumanoidRootPart")
	local leftArm = char:FindFirstChild("Left Arm") or char:FindFirstChild("LeftHand") or char:FindFirstChild("LeftUpperArm")
	local rightArm = char:FindFirstChild("Right Arm") or char:FindFirstChild("RightHand") or char:FindFirstChild("RightUpperArm")
	
	if humanoidRootPart and (leftArm or rightArm) then
		local lookVector = humanoidRootPart.CFrame.LookVector
		local backDirection = -lookVector * 20 -- Gấp 20 lần khoảng cách
		
		if leftArm then
			leftArm.CFrame = leftArm.CFrame + backDirection
		end
		
		if rightArm then
			rightArm.CFrame = rightArm.CFrame + backDirection
		end
	end
end

-- Hàm reset tay về vị trí cũ
local function resetArms()
	-- Tay sẽ tự động về vị trí cũ khi ngừng can thiệp
	-- Do game tự xử lý
end

-- Hàm bắt đầu loop kéo tay
local function startArmLoop()
	if armLoop then return end
	
	armLoop = RunService.Heartbeat:Connect(function()
		if armExtendEnabled and modEnabled then
			extendArms()
		end
	end)
	
	-- Thêm loop 0.1 giây để đảm bảo
	spawn(function()
		while armExtendEnabled and modEnabled do
			extendArms()
			wait(0.1)
		end
	end)
end

-- Hàm dừng loop kéo tay
local function stopArmLoop()
	if armLoop then
		armLoop:Disconnect()
		armLoop = nil
	end
	resetArms()
end

-- Xử lý nút toggle mod chính
modToggle.MouseButton1Click:Connect(function()
	modEnabled = not modEnabled
	
	if modEnabled then
		modToggle.Text = "ON"
		modToggle.BackgroundColor3 = Color3.fromRGB(50, 255, 50)
		armToggle.Visible = true
	else
		modToggle.Text = "OFF"
		modToggle.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
		armToggle.Visible = false
		
		-- Tắt luôn arm extend nếu mod tắt
		armExtendEnabled = false
		armToggle.Text = "Kéo ra sau (OFF)"
		armToggle.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
		stopArmLoop()
	end
end)

-- Xử lý nút toggle kéo tay
armToggle.MouseButton1Click:Connect(function()
