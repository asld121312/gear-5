-- Hàm lấy character mới
local function getCharacter()
	character = player.Character or player.CharacterAdded:Wait()
	return character
end

player.CharacterAdded:Connect(function(char)
	character = char
end)

-- Hàm kéo CÁNH TAY ra sau (chỉ cánh tay thôi!)
local function extendArms()
	local char = getCharacter()
	if not char then return end
	
	local humanoidRootPart = char:FindFirstChild("HumanoidRootPart")
	if not humanoidRootPart then return end
	
	-- Lấy hướng nhìn ngược lại (ra sau)
	local backDirection = -humanoidRootPart.CFrame.LookVector
	
	-- R6 Rig (cũ)
	local leftArmR6 = char:FindFirstChild("Left Arm")
	local rightArmR6 = char:FindFirstChild("Right Arm")
	
	-- R15 Rig (mới) - Lấy các phần của cánh tay
	local leftUpperArm = char:FindFirstChild("LeftUpperArm")
	local leftLowerArm = char:FindFirstChild("LeftLowerArm")
	local leftHand = char:FindFirstChild("LeftHand")
	
	local rightUpperArm = char:FindFirstChild("RightUpperArm")
	local rightLowerArm = char:FindFirstChild("RightLowerArm")
	local rightHand = char:FindFirstChild("RightHand")
	
	-- Khoảng cách kéo ra sau (gấp 20 lần)
	local extendDistance = 20
	local offset = backDirection * extendDistance
	
	-- Di chuyển cánh tay R6
	if leftArmR6 then
		leftArmR6.CFrame = leftArmR6.CFrame + offset
	end
	
	if rightArmR6 then
		rightArmR6.CFrame = rightArmR6.CFrame + offset
	end
	
	-- Di chuyển cánh tay R15 (từng phần)
	if leftUpperArm then
		leftUpperArm.CFrame = leftUpperArm.CFrame + offset
	end
	if leftLowerArm then
		leftLowerArm.CFrame = leftLowerArm.CFrame + offset
	end
	if leftHand then
		leftHand.CFrame = leftHand.CFrame + offset
	end
	
	if rightUpperArm then
		rightUpperArm.CFrame = rightUpperArm.CFrame + offset
	end
	if rightLowerArm then
		rightLowerArm.CFrame = rightLowerArm.CFrame + offset
	end
	if rightHand then
		rightHand.CFrame = rightHand.CFrame + offset
	end
end

-- Hàm bắt đầu loop kéo tay mỗi 0.1 giây
local function startArmLoop()
	armSpawnLoop = true
	
	-- Loop chính chạy mỗi 0.1 giây
	spawn(function()
		while armSpawnLoop and armExtendEnabled and modEnabled do
			extendArms()
			wait(0.1) -- Mỗi 0.1 giây tele tay ra sau
		end
	end)
end

-- Hàm dừng loop kéo tay
local function stopArmLoop()
	armSpawnLoop = false
	-- Tay sẽ tự về vị trí cũ do game xử lý
end

-- Xử lý nút toggle mod chính
modToggle.MouseButton1Click:Connect(function()
	modEnabled = not modEnabled
	
	if modEnabled then
		modToggle.Text = "ON"
		modToggle.BackgroundColor3 = Color3.fromRGB(50, 255, 50)
		armToggle.Visible = true
	else
		modToggle.Text = "OFF"
		modToggle.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
		armToggle.Visible = false
		
		-- Tắt luôn arm extend nếu mod tắt
		armExtendEnabled = false
		armToggle.Text = "Kéo ra sau (OFF)"
		armToggle.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
		stopArmLoop()
	end
end)

-- Xử lý nút toggle kéo tay
armToggle.MouseButton1Click:Connect(function()
	if not modEnabled then return end
	
	armExtendEnabled = not armExtendEnabled
	
	if armExtendEnabled then
		armToggle.Text = "Kéo ra sau (ON)"
		armToggle.BackgroundColor3 = Color3.fromRGB(50, 200, 255)
		startArmLoop()
	else
		armToggle.Text = "Kéo ra sau (OFF)"
		armToggle.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
		stopArmLoop()
	end
end)

